{
  "formatVersion": 2,
  "id": "acme-dark",
  "name": "Acme Dark",
  "extends": "zap-dark",
  "swatches": {
    "orange": "#E8590C",
    "red": "#C62828",
    "lightRed": "#E53935",
    "white": "#FFFFFF"
  },
  "names": {
    "accent": { "color": "$orange" },
    "danger": { "color": "$red" },
    "dangerHover": { "color": "$lightRed" },
    "onDanger": { "color": "$white" },
    "headline": { "color": "$accent", "font": { "height": 14, "style": "bold" } }
  },
  "controls": {
    "Label[WRAP]": {
      "foreground": "$muted"
    }
  },
  "classes": {
    "Label.headline": {
      "font": "$headline",
      "foreground": "$headline"
    },
    "Button.danger": {
      "background": "$danger",
      "foreground": "$onDanger",
      "states": {
        "hover": {
          "background": "$dangerHover"
        }
      }
    }
  }
}
