@@ -205,6 +205,27 @@ public class FontRegistry extends ResourceRegistry {
 	 */
 	private final List<Font> staleFonts = new ArrayList<>();
 
+	/** ZapThemes: the data each font of this registry was made from, for {@link #staleOrNew}. */
+	private final Map<Font, FontData[]> fontDataOf = new java.util.IdentityHashMap<>();
+
+	/**
+	 * ZapThemes: a stale font made from the same data if there is one, else a new font. Stale fonts
+	 * are only disposed with the display, so without this, putting the same few values over and
+	 * over (switching themes, zooming in and out) would allocate new fonts every time.
+	 */
+	private Font staleOrNew(Display display, FontData[] data) {
+		for (Iterator<Font> it = staleFonts.iterator(); it.hasNext();) {
+			Font font = it.next();
+			if (!font.isDisposed() && font.getDevice() == display && Arrays.equals(fontDataOf.get(font), data)) {
+				it.remove();
+				return font;
+			}
+		}
+		Font font = new Font(display, data);
+		fontDataOf.put(font, data);
+		return font;
+	}
+
 	/**
 	 * Runnable that cleans up the manager on disposal of the display.
 	 */
