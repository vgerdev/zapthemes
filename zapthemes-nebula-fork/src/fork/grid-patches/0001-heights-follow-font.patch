 	@Override
 	public void setFont(final Font font) {
+		final Font previous = getFont();
 		dataVisualizer.setDefaultFont(font);
 		defaultFont = font;
 		super.setFont(font);
+		// ZapThemes: heights come from the font, so they follow it (a zoom or a theme font change),
+		// down as well as up.
+		if (!getFont().equals(previous)) {
+			fontChanged();
+		}
+	}
+
+	/**
+	 * ZapThemes: recomputes what was sized from the old font: the header and footer heights, the
+	 * row header width and, unless the application set it, the item height. Items whose height
+	 * differs from the grid's item height (set one by one) keep it.
+	 */
+	private void fontChanged() {
+		estimate(sizingGC -> {
+			computeHeaderHeight(sizingGC);
+			computeFooterHeight(sizingGC);
+		});
+		if (!userModifiedItemHeight) {
+			final int old = itemHeight;
+			itemHeight = items.isEmpty() || columns.isEmpty()
+					? estimateWithResult(sizingGC -> sizingGC.getFontMetrics().getHeight() + 2)
+					: computeItemHeight(items.get(0));
+			if (itemHeight != old) {
+				final boolean differing = hasDifferingHeights;
+				for (final GridItem item : items) {
+					if (item.getHeight() == old) {
+						item.setHeight(itemHeight);
+					}
+				}
+				hasDifferingHeights = differing;
+			}
+		}
+		if (rowHeaderVisible && isAutoWidth()) {
+			computeRowHeaderWidth(0);
+		}
+		bottomIndex = -1;
+		setScrollValuesObsolete();
+		redraw();
 	}
 
