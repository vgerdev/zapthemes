{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zapthemes.com/theme.schema.json",
  "title": "ZapThemes theme",
  "description": "A theme for SWT/JFace/Nebula controls. Values may reference the palette with \"$name\".",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "Unique theme id, e.g. \"zap-dark\"." },
    "name": { "type": "string", "description": "Display name." },
    "extends": { "type": "string", "description": "Id of the theme this one is layered on." },
    "palette": {
      "type": "object",
      "description": "Named colors and fonts, referenced from rules as \"$name\".",
      "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/color" }, { "$ref": "#/$defs/font" }, { "$ref": "#/$defs/reference" }] }
    },
    "defaults": { "$ref": "#/$defs/rule", "description": "Properties applied to every widget before its type rule." },
    "controls": {
      "type": "object",
      "description": "Rules by THEME_CONTROL_TYPE (\"Button\"), or by type and SWT style bits (\"Button[CHECK|FLAT]\").",
      "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\[[A-Z0-9_]+(\|[A-Z0-9_]+)*\])?$" },
      "additionalProperties": { "$ref": "#/$defs/rule" }
    },
    "classes": {
      "type": "object",
      "description": "Rules by THEME_CLASS: \"Button.primary\" or \"*.primary\" for any type.",
      "propertyNames": { "pattern": "^(\*|[A-Za-z_][A-Za-z0-9_]*)\.[A-Za-z0-9_-]+$" },
      "additionalProperties": { "$ref": "#/$defs/rule" }
    },
    "registries": {
      "type": "object",
      "description": "Named resources for toolkit registries, keyed by their symbolic names (JFace ColorRegistry / FontRegistry).",
      "properties": {
        "colors": { "type": "object", "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/color" }, { "$ref": "#/$defs/reference" }] } },
        "fonts": { "type": "object", "additionalProperties": { "anyOf": [{ "$ref": "#/$defs/font" }, { "$ref": "#/$defs/reference" }] } }
      }
    },
    "platform": {
      "type": "object",
      "description": "Global settings per SWT windowing system.",
      "properties": {
        "win32": { "type": "object" },
        "gtk": { "type": "object" },
        "cocoa": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "color": { "type": "string", "pattern": "^#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})$" },
    "reference": { "type": "string", "pattern": "^\$.+$" },
    "font": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "height": { "type": "integer", "minimum": 1 },
        "style": { "type": "string", "pattern": "^(normal|bold|italic)([|, ]+(normal|bold|italic))*$" }
      },
      "additionalProperties": false
    },
    "rule": {
      "type": "object",
      "description": "Properties of a widget. Keys named background/foreground or ending in Background/Foreground/Color are colors; font or ...Font are fonts; other keys belong to the type's styler.",
      "properties": {
        "inherit": { "type": "string", "description": "Copy another control rule first." },
        "states": {
          "type": "object",
          "description": "Overrides per state, used by owner-draw renderers.",
          "propertyNames": { "enum": ["hover", "pressed", "focused", "disabled", "selected"] },
          "additionalProperties": { "$ref": "#/$defs/rule" }
        }
      },
      "patternProperties": {
        "^(background|foreground)$|(Background|Foreground|Color)$": { "anyOf": [{ "$ref": "#/$defs/color" }, { "$ref": "#/$defs/reference" }] },
        "^font$|Font$": { "anyOf": [{ "$ref": "#/$defs/font" }, { "$ref": "#/$defs/reference" }] }
      }
    }
  }
}
