{
  "id": "zap-light",
  "name": "Zap Light",
  "extends": "zap-base",
  "palette": {
    "bg": "#F7F8FA",
    "surface": "#FFFFFF",
    "fg": "#1F2328",
    "muted": "#EBECF0",
    "hover": "#DFE1E5",
    "disabled": "#8C8F94",
    "selection": "#CFDEFC",
    "accent": "#3574F0",
    "onAccent": "#FFFFFF",
    "error": "#C62828",
    "qualifier": "#6A737D",
    "stripe": "#F3F4F6",
    "border": "#C9CCD1"
  },
  "defaults": {
    "background": "$bg",
    "foreground": "$fg"
  },
  "controls": {
    "Text": {
      "background": "$surface"
    },
    "Combo": {
      "background": "$surface"
    },
    "StyledText": {
      "selectionBackground": "$selection",
      "selectionForeground": "$fg",
      "marginColor": "$surface"
    },
    "Table": {
      "background": "$surface",
      "headerBackground": "$muted",
      "headerForeground": "$fg",
      "selectionBackground": "$selection",
      "selectionForeground": "$fg",
      "alternateRowBackground": "$stripe",
      "gridLineColor": "$muted",
      "states": {
        "hover": {
          "background": "$hover"
        }
      }
    },
    "Tree": {
      "inherit": "Table"
    },
    "Link": {
      "linkForeground": "$accent"
    },
    "Button[PUSH]": {
      "background": "$muted",
      "states": {
        "hover": {
          "background": "$hover"
        },
        "pressed": {
          "background": "$accent",
          "foreground": "$onAccent"
        },
        "disabled": {
          "foreground": "$disabled"
        },
        "focused": {
          "borderColor": "$accent"
        }
      }
    },
    "CTabFolder": {
      "selectionBackground": "$surface",
      "selectionForeground": "$accent",
      "selectionBarThickness": 2,
      "highlight": true
    },
    "FlatButton": {
      "background": "$muted",
      "foreground": "$fg",
      "borderColor": "$disabled",
      "accentColor": "$accent",
      "arc": 6,
      "states": {
        "hover": {
          "background": "$hover"
        },
        "pressed": {
          "background": "$accent",
          "foreground": "$onAccent"
        },
        "disabled": {
          "foreground": "$disabled",
          "borderColor": "$muted"
        },
        "focused": {
          "borderColor": "$accent"
        }
      }
    },
    "FlatButton[CHECK]": {
      "background": "$bg",
      "borderColor": "$disabled",
      "boxBackground": "$surface"
    },
    "FlatButton[RADIO]": {
      "background": "$bg",
      "borderColor": "$disabled",
      "boxBackground": "$surface"
    },
    "FlatGroup": {
      "borderColor": "$muted",
      "titleForeground": "$fg",
      "titleFont": "$font.strong"
    },
    "FlatProgressBar": {
      "background": "$muted",
      "barColor": "$accent",
      "errorColor": "$error"
    },
    "ProgressBar": {
      "background": "$muted",
      "foreground": "$accent"
    },
    "Grid": {
      "background": "$surface",
      "lineColor": "$border",
      "cellHeaderSelectionBackground": "$selection"
    },
    "GridItem": {
      "background": "$surface",
      "foreground": "$fg"
    },
    "CDateTime": {
      "background": "$surface",
      "pickerBackgroundColor": "$surface",
      "pickerForegroundColor": "$fg",
      "pickerTodayColor": "$accent",
      "pickerActiveDayColor": "$fg",
      "pickerInactiveDayColor": "$disabled",
      "buttonHoverBackgroundColor": "$hover",
      "buttonHoverBorderColor": "$border",
      "buttonSelectedBackgroundColor": "$accent",
      "buttonSelectedBorderColor": "$accent"
    },
    "Gallery": {
      "background": "$surface",
      "groupRenderer.titleBackground": "$muted",
      "groupRenderer.titleForeground": "$fg",
      "itemRenderer.selectionBackgroundColor": "$accent",
      "itemRenderer.selectionForegroundColor": "$onAccent",
      "itemRenderer.foregroundColor": "$fg",
      "itemRenderer.backgroundColor": "$surface"
    },
    "GalleryItem": {
      "background": "$surface",
      "foreground": "$fg"
    },
    "TableCombo": {
      "background": "$surface",
      "borderColor": "$border",
      "oddLinesBackgroundColor": "$surface",
      "evenLinesBackgroundColor": "$stripe",
      "oddLinesForegroundColor": "$fg",
      "evenLinesForegroundColor": "$fg"
    },
    "CTreeCombo": {
      "background": "$surface"
    },
    "CTreeComboItem": {
      "background": "$surface",
      "foreground": "$fg"
    },
    "PGroup": {
      "strategy.borderColor": "$border",
      "titleBackground": "$surface",
      "titleBackgroundGradient": "$muted",
      "foreground": "$fg"
    },
    "Header": {
      "titleColor": "$fg",
      "gradientStart": "$surface",
      "gradientEnd": "$bg",
      "separatorColor": "$border"
    },
    "SwitchButton": {
      "selectedBackgroundColor": "$accent",
      "selectedForegroundColor": "$onAccent",
      "unselectedBackgroundColor": "$muted",
      "unselectedForegroundColor": "$fg",
      "borderColor": "$border",
      "buttonBorderColor": "$border",
      "buttonBackgroundColor1": "$surface",
      "buttonBackgroundColor2": "$surface",
      "focusColor": "$accent"
    },
    "Chips": {
      "chipsBackground": "$muted",
      "borderColor": "$border",
      "hoverBackground": "$hover",
      "hoverForeground": "$fg",
      "hoverBorderColor": "$border",
      "pushedStateBackground": "$accent",
      "pushedStateForeground": "$onAccent",
      "pushedStateBorderColor": "$accent",
      "closeButtonForeground": "$fg",
      "closeButtonBackground": "$muted",
      "closeButtonHoverForeground": "$onAccent",
      "closeButtonHoverBackground": "$accent"
    },
    "BadgedLabel": {
      "badgeBackground": "$accent",
      "badgeForeground": "$onAccent",
      "textColor": "$fg",
      "backgroundColor": "$muted",
      "borderColor": "$border"
    },
    "Carousel": {
      "arrowColor": "$fg",
      "circleBackground": "$muted",
      "circleForeground": "$accent",
      "circleHoverColor": "$hover"
    },
    "ProgressCircle": {
      "highlightColor": "$accent",
      "background": "$bg",
      "foreground": "$muted"
    },
    "RoundedToolbar": {
      "borderColor": "$border"
    },
    "RoundedToolItem": {
      "textColor": "$fg",
      "textColorSelected": "$onAccent"
    },
    "BreadcrumbItem": {
      "textColor": "$fg",
      "textColorSelected": "$accent"
    },
    "TextAssist": {
      "background": "$surface"
    },
    "PasswordRevealer": {
      "background": "$surface"
    },
    "Tiles": {
      "background": "$surface"
    },
    "RangeSlider": {
      "foreground": "$border"
    },
    "PShelf": {
      "renderer.shadeColor": "$muted"
    },
    "TimelineComposite": {
      "background": "$surface",
      "gridColor": "$border",
      "overviewSelectionBackgroundColor": "$accent",
      "cursorColor": "$accent",
      "selectedCursorColor": "$error"
    },
    "CollapsibleButtons": {
      "background": "$bg",
      "foreground": "$fg",
      "borderColor": "$border",
      "darkResizeColor": "$border",
      "lightResizeColor": "$muted",
      "dotDarkColor": "$disabled",
      "dotLightColor": "$muted",
      "dotMiddleColor": "$border",
      "buttonBackgroundColorTop": "$muted",
      "buttonBackgroundColorMiddle": "$muted",
      "buttonBackgroundColorBottom": "$muted",
      "selectedButtonBackgroundColorTop": "$accent",
      "selectedButtonBackgroundColorMiddle": "$accent",
      "selectedButtonBackgroundColorBottom": "$accent",
      "hoverButtonBackgroundColorTop": "$hover",
      "hoverButtonBackgroundColorMiddle": "$hover",
      "hoverButtonBackgroundColorBottom": "$hover",
      "hoverSelectedButtonBackgroundColorTop": "$accent",
      "hoverSelectedButtonBackgroundColorMiddle": "$accent",
      "hoverSelectedButtonBackgroundColorBottom": "$accent",
      "buttonTextColor": "$fg"
    },
    "DateChooser": {
      "background": "$surface"
    }
  },
  "classes": {
    "Button.primary": {
      "background": "$accent",
      "foreground": "$onAccent"
    },
    "Label.muted": {
      "foreground": "$disabled"
    },
    "*.banner": {
      "background": "$surface",
      "foreground": "$fg"
    },
    "*.info": {
      "background": "$muted",
      "foreground": "$fg"
    },
    "*.pane": {
      "background": "$surface"
    },
    "Text.plain": {
      "background": "$bg"
    },
    "FlatButton.primary": {
      "background": "$accent",
      "foreground": "$onAccent",
      "borderColor": "$accent"
    }
  },
  "platform": {
    "*": {
      "darkThemePreferred": false
    },
    "win32": {
      "darkScrollbars": false,
      "darkCombos": false,
      "darkTextIcons": false,
      "progressBarColors": true,
      "menuBarBackground": "$bg",
      "menuBarForeground": "$fg",
      "menuBarBorderColor": "$muted",
      "tableHeaderLineColor": "$muted",
      "disabledLabelForeground": "$disabled"
    }
  },
  "registries": {
    "colors": {
      "ERROR_COLOR": "$error",
      "HYPERLINK_COLOR": "$accent",
      "ACTIVE_HYPERLINK_COLOR": "$accent",
      "QUALIFIER_COLOR": "$qualifier",
      "DECORATIONS_COLOR": "$qualifier",
      "COUNTER_COLOR": "$accent",
      "CONTENT_ASSIST_BACKGROUND_COLOR": "$surface",
      "CONTENT_ASSIST_FOREGROUND_COLOR": "$fg",
      "org.eclipse.ui.workbench.INFORMATION_BACKGROUND": "$surface",
      "org.eclipse.ui.workbench.INFORMATION_FOREGROUND": "$fg"
    },
    "systemColors": {
      "COLOR_WIDGET_BACKGROUND": "$bg",
      "COLOR_WIDGET_FOREGROUND": "$fg",
      "COLOR_LIST_BACKGROUND": "$surface",
      "COLOR_LIST_FOREGROUND": "$fg",
      "COLOR_LIST_SELECTION": "$accent",
      "COLOR_LIST_SELECTION_TEXT": "$onAccent",
      "COLOR_WIDGET_NORMAL_SHADOW": "$border",
      "COLOR_WIDGET_LIGHT_SHADOW": "$muted",
      "COLOR_WIDGET_HIGHLIGHT_SHADOW": "$surface",
      "COLOR_WIDGET_DARK_SHADOW": "$disabled",
      "COLOR_WIDGET_BORDER": "$border",
      "COLOR_TITLE_BACKGROUND": "$surface",
      "COLOR_TITLE_FOREGROUND": "$fg",
      "COLOR_TITLE_BACKGROUND_GRADIENT": "$muted",
      "COLOR_TITLE_INACTIVE_BACKGROUND": "$muted",
      "COLOR_TITLE_INACTIVE_FOREGROUND": "$disabled",
      "COLOR_TITLE_INACTIVE_BACKGROUND_GRADIENT": "$muted",
      "COLOR_INFO_BACKGROUND": "$muted",
      "COLOR_INFO_FOREGROUND": "$fg",
      "COLOR_TEXT_DISABLED_BACKGROUND": "$muted",
      "COLOR_WIDGET_DISABLED_FOREGROUND": "$disabled",
      "COLOR_LINK_FOREGROUND": "$accent"
    }
  }
}
