{
  "id": "zap-light",
  "name": "Zap Light",
  "extends": "zap-base",
  "palette": {
    "bg": "#F7F8FA",
    "surface": "#FFFFFF",
    "fg": "#1F2328",
    "muted": "#EBECF0",
    "hover": "#DFE1E5",
    "disabled": "#8C8F94",
    "selection": "#CFDEFC",
    "accent": "#3574F0",
    "onAccent": "#FFFFFF",
    "error": "#C62828",
    "qualifier": "#6A737D",
    "stripe": "#F3F4F6"
  },
  "defaults": {
    "background": "$bg",
    "foreground": "$fg"
  },
  "controls": {
    "Text": {
      "background": "$surface"
    },
    "Combo": {
      "background": "$surface"
    },
    "StyledText": {
      "selectionBackground": "$selection",
      "selectionForeground": "$fg",
      "marginColor": "$surface"
    },
    "Table": {
      "background": "$surface",
      "headerBackground": "$muted",
      "headerForeground": "$fg",
      "selectionBackground": "$selection",
      "selectionForeground": "$fg",
      "alternateRowBackground": "$stripe",
      "gridLineColor": "$muted",
      "states": {
        "hover": {
          "background": "$hover"
        }
      }
    },
    "Tree": {
      "inherit": "Table"
    },
    "Link": {
      "linkForeground": "$accent"
    },
    "Button[PUSH]": {
      "background": "$muted",
      "states": {
        "hover": {
          "background": "$hover"
        },
        "pressed": {
          "background": "$accent",
          "foreground": "$onAccent"
        },
        "disabled": {
          "foreground": "$disabled"
        },
        "focused": {
          "borderColor": "$accent"
        }
      }
    },
    "CTabFolder": {
      "selectionBackground": "$surface",
      "selectionForeground": "$accent",
      "selectionBarThickness": 2,
      "highlight": true
    },
    "FlatButton": {
      "background": "$muted",
      "foreground": "$fg",
      "borderColor": "$disabled",
      "accentColor": "$accent",
      "arc": 6,
      "states": {
        "hover": {
          "background": "$hover"
        },
        "pressed": {
          "background": "$accent",
          "foreground": "$onAccent"
        },
        "disabled": {
          "foreground": "$disabled",
          "borderColor": "$muted"
        },
        "focused": {
          "borderColor": "$accent"
        }
      }
    },
    "FlatButton[CHECK]": {
      "background": "$bg",
      "borderColor": "$disabled",
      "boxBackground": "$surface"
    },
    "FlatButton[RADIO]": {
      "background": "$bg",
      "borderColor": "$disabled",
      "boxBackground": "$surface"
    },
    "FlatGroup": {
      "borderColor": "$muted",
      "titleForeground": "$fg",
      "titleFont": "$font.strong"
    },
    "FlatProgressBar": {
      "background": "$muted",
      "barColor": "$accent",
      "errorColor": "$error"
    },
    "ProgressBar": {
      "background": "$muted",
      "foreground": "$accent"
    }
  },
  "classes": {
    "Button.primary": {
      "background": "$accent",
      "foreground": "$onAccent"
    },
    "Label.muted": {
      "foreground": "$disabled"
    },
    "*.banner": {
      "background": "$surface",
      "foreground": "$fg"
    },
    "*.info": {
      "background": "$muted",
      "foreground": "$fg"
    },
    "*.pane": {
      "background": "$surface"
    },
    "Text.plain": {
      "background": "$bg"
    },
    "FlatButton.primary": {
      "background": "$accent",
      "foreground": "$onAccent",
      "borderColor": "$accent"
    }
  },
  "platform": {
    "*": {
      "darkThemePreferred": false
    },
    "win32": {
      "darkScrollbars": false,
      "darkCombos": false,
      "darkTextIcons": false,
      "progressBarColors": true,
      "menuBarBackground": "$bg",
      "menuBarForeground": "$fg",
      "menuBarBorderColor": "$muted",
      "tableHeaderLineColor": "$muted",
      "disabledLabelForeground": "$disabled"
    }
  },
  "registries": {
    "colors": {
      "ERROR_COLOR": "$error",
      "HYPERLINK_COLOR": "$accent",
      "ACTIVE_HYPERLINK_COLOR": "$accent",
      "QUALIFIER_COLOR": "$qualifier",
      "DECORATIONS_COLOR": "$qualifier",
      "COUNTER_COLOR": "$accent",
      "CONTENT_ASSIST_BACKGROUND_COLOR": "$surface",
      "CONTENT_ASSIST_FOREGROUND_COLOR": "$fg",
      "org.eclipse.ui.workbench.INFORMATION_BACKGROUND": "$surface",
      "org.eclipse.ui.workbench.INFORMATION_FOREGROUND": "$fg"
    }
  }
}
