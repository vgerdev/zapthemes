{
  "formatVersion": 2,
  "id": "zap-light",
  "name": "Zap Light",
  "extends": "zap-base",
  "dark": false,
  "names": {
    "background": { "color": "#F7F8FA" },
    "surface": { "color": "#FFFFFF" },
    "raised": { "color": "#EBECF0" },
    "stripe": { "color": "#F3F4F6" },
    "hover": { "color": "#DFE1E5" },
    "selection": { "color": "#CFDEFC" },
    "chrome": { "color": "#E9EBEF" },
    "foreground": { "color": "#1F2328" },
    "muted": { "color": "#6A737D" },
    "disabled": { "color": "#8C8F94" },
    "onAccent": { "color": "#FFFFFF" },
    "link": { "color": "$accent" },
    "selectionForeground": { "color": "$foreground" },
    "onBadge": { "color": "#FFFFFF" },
    "heading1": { "color": "$foreground" },
    "heading2": { "color": "$foreground" },
    "heading3": { "color": "$foreground" },
    "strong": { "color": "$foreground" },
    "caption": { "color": "$muted" },
    "border": { "color": "#C9CCD1" },
    "gridLine": { "color": "$raised" },
    "focus": { "color": "$accent" },
    "accent": { "color": "#3574F0" },
    "error": { "color": "#C62828" },
    "warning": { "color": "#B35C00" },
    "success": { "color": "#1E7B4B" },
    "info": { "color": "#7A3EB1" },
    "badge": { "color": "#3B3F45" },
    "titleBar": { "color": "#3574F0" },
    "titleBarForeground": { "color": "#FFFFFF" },
    "titleBarInactive": { "color": "#6F9AF3" },
    "titleBarInactiveForeground": { "color": "#E3EBFC" },
    "keyword": { "color": "#0033B3" },
    "string": { "color": "#067D17" },
    "comment": { "color": "#8C8C8C" },
    "number": { "color": "#1750EB" },
    "warningBackground": { "color": "#FFF4CE" },
    "warningBorder": { "color": "#E8D28A" },
    "infoBackground": { "color": "#EAF1FD" },
    "errorBackground": { "color": "#FDE7E9" },
    "successBackground": { "color": "#DFF6DD" }
  },
  "platform": {
    "*": { "darkThemePreferred": false },
    "win32": {
      "darkScrollbars": false,
      "darkCombos": false,
      "darkTextIcons": false
    }
  }
}
