{
  "formatVersion": 2,
  "id": "zap-dark",
  "name": "Zap Dark",
  "extends": "zap-base",
  "dark": true,
  "names": {
    "background": { "color": "#1E1F22" },
    "surface": { "color": "#2B2D30" },
    "raised": { "color": "#393B40" },
    "stripe": { "color": "#303236" },
    "hover": { "color": "#43454A" },
    "selection": { "color": "#2E436E" },
    "chrome": { "color": "#18191B" },
    "foreground": { "color": "#DFE1E5" },
    "muted": { "color": "#8C8F94" },
    "disabled": { "color": "#6F737A" },
    "onAccent": { "color": "#FFFFFF" },
    "link": { "color": "$accent" },
    "selectionForeground": { "color": "$foreground" },
    "onBadge": { "color": "#1E1F22" },
    "heading1": { "color": "$foreground" },
    "heading2": { "color": "$foreground" },
    "heading3": { "color": "$foreground" },
    "strong": { "color": "$foreground" },
    "caption": { "color": "$muted" },
    "border": { "color": "#4A4D52" },
    "gridLine": { "color": "$raised" },
    "focus": { "color": "$accent" },
    "accent": { "color": "#3574F0" },
    "error": { "color": "#F07178" },
    "warning": { "color": "#E5A050" },
    "success": { "color": "#5FC48A" },
    "info": { "color": "#B98BE8" },
    "badge": { "color": "#DFE1E5" },
    "titleBar": { "color": "#2B2D30" },
    "titleBarForeground": { "color": "#DFE1E5" },
    "titleBarInactive": { "color": "#25262A" },
    "titleBarInactiveForeground": { "color": "#8C8F94" },
    "keyword": { "color": "#CF8E6D" },
    "string": { "color": "#6AAB73" },
    "comment": { "color": "#7A7E85" },
    "number": { "color": "#2AACB8" },
    "warningBackground": { "color": "#433519" },
    "warningBorder": { "color": "#6B5A2A" },
    "infoBackground": { "color": "#1F2D45" },
    "errorBackground": { "color": "#442726" },
    "successBackground": { "color": "#22382A" }
  },
  "controls": {
    "TitleBar": {
      "hoverBackground": "$hover",
      "pressedBackground": "$raised",
      "searchBackground": "$background",
      "searchBorderColor": "$border",
      "focusColor": "$focus",
      "useAccent": false
    }
  },
  "platform": {
    "*": { "darkThemePreferred": true },
    "win32": {
      "darkScrollbars": true,
      "darkCombos": true,
      "darkTextIcons": true
    }
  }
}
