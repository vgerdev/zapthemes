{
  "formatVersion": 2,
  "id": "zap-high-contrast",
  "name": "Zap High Contrast",
  "extends": "zap-dark",
  "names": {
    "background": { "color": "#000000" },
    "surface": { "color": "#000000" },
    "raised": { "color": "#1F1F1F" },
    "stripe": { "color": "#141414" },
    "hover": { "color": "#3A3A3A" },
    "selection": { "color": "#0037DA" },
    "chrome": { "color": "#000000" },
    "foreground": { "color": "#FFFFFF" },
    "muted": { "color": "#C8C8C8" },
    "disabled": { "color": "#A6A6A6" },
    "onAccent": { "color": "#000000" },
    "link": { "color": "#00FFFF" },
    "onBadge": { "color": "#000000" },
    "border": { "color": "#FFFFFF" },
    "gridLine": { "color": "#8A8A8A" },
    "accent": { "color": "#FFFF00" },
    "error": { "color": "#FF8080" },
    "warning": { "color": "#FF8000" },
    "success": { "color": "#00FF00" },
    "info": { "color": "#00FFFF" },
    "badge": { "color": "#FFFF00" },
    "titleBar": { "color": "#000000" },
    "titleBarForeground": { "color": "#FFFFFF" },
    "titleBarInactive": { "color": "#000000" },
    "titleBarInactiveForeground": { "color": "#A6A6A6" },
    "keyword": { "color": "#FFFF00" },
    "string": { "color": "#00FF00" },
    "comment": { "color": "#C8C8C8" },
    "number": { "color": "#00FFFF" },
    "avatar": { "color": "$accent" },
    "onAvatar": { "color": "$onAccent" }
  },
  "controls": {
    "TitleBar": {
      "hoverBackground": "$selection",
      "pressedBackground": "$selection",
      "searchForeground": "$foreground"
    },
    "Ribbon": {
      "useAppAccent": false,
      "states": {
        "hover": { "borderColor": "$accent" },
        "pressed": {
          "background": "$accent",
          "foreground": "$onAccent",
          "borderColor": "$accent"
        }
      },
      "tabHoverIndicatorColor": "$accent",
      "itemCheckedBackground": "$background",
      "keyTipBorderColor": "$onBadge"
    },
    "RibbonBackstage": {
      "navBackground": "$background",
      "navForeground": "$foreground",
      "navHoverBackground": "$hover",
      "navSelectedBackground": "$selection",
      "navSelectedForeground": "$foreground",
      "useAppAccent": false
    },
    "RibbonMessageBar": {
      "background": "$background",
      "borderColor": "$border",
      "states": {
        "info": { "background": "$background" },
        "error": {
          "background": "$background",
          "borderColor": "$error",
          "iconColor": "$error"
        },
        "success": { "background": "$background" }
      }
    },
    "CTabFolder": { "selectionBarThickness": 3 },
    "FlatButton": {
      "borderColor": "$border",
      "states": {
        "focused": { "borderColor": "$accent" }
      }
    },
    "FlatButton[CHECK]": { "borderColor": "$border" },
    "FlatButton[RADIO]": { "borderColor": "$border" },
    "FlatGroup": { "borderColor": "$border" },
    "CDateTime": { "buttonSelectedBackgroundColor": "$selection" },
    "SwitchButton": {
      "selectedBackgroundColor": "$selection",
      "selectedForegroundColor": "$foreground"
    },
    "TimelineComposite": { "selectedCursorColor": "$link" },
    "AbstractLinearMarkedFigure": { "fillColor": "$selection" }
  },
  "classes": {
    "Label.muted": { "foreground": "$muted" },
    "*.ruler": { "foreground": "$gridLine" }
  },
  "platform": {
    "win32": { "menuBarBorderColor": "$border" }
  },
  "registries": {
    "systemColors": {
      "COLOR_LIST_SELECTION": "$selection",
      "COLOR_LIST_SELECTION_TEXT": "$foreground",
      "COLOR_WIDGET_LIGHT_SHADOW": "$border",
      "COLOR_WIDGET_DARK_SHADOW": "$border"
    }
  }
}
